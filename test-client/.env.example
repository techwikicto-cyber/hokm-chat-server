# این فایل را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env

# آدرس سرور چت. اگر روی همین ماشین است 127.0.0.1 کار می‌کند
# (چون سرویس tester با network_mode: host اجرا می‌شود).
CHAT_URL=http://127.0.0.1:3008

# مقدار AES_ENCRYPTION_SECRET_KEY از config.js سرور — دقیقاً ۳۲ کاراکتر.
AES_KEY=p2s5v8y/B?E(H+MbPeShVmYq3t6w9z$C

# مقدار PUBLIC_ROOM_NAME سرور.
PUBLIC_ROOM=public_chat_room

# تایم‌اوت هر مرحله به میلی‌ثانیه. برای سرورهای دور یا لینک کند زیادش کنید.
TIMEOUT=10000

# پورت حالت مرورگر روی ماشین میزبان.
UI_PORT=8080
